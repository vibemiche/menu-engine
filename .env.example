# Database: SQLite locale in sviluppo, Turso (libsql://...) in produzione
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=genera-una-stringa-casuale-lunga
BETTER_AUTH_URL=http://localhost:3000

# Login con Google (console.cloud.google.com > Credenziali > ID client OAuth)
# URI di reindirizzamento autorizzato: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API
ANTHROPIC_API_KEY=
# Modello per la lettura di foto, PDF e XML (economico e veloce)
SCAN_MODEL=claude-haiku-5-5
# Modello per l'agente strategia (ragionamento)
STRATEGY_MODEL=claude-opus-5-5
